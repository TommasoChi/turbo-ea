# Throwaway values for the isolated browser e2e stack (scripts/e2e/docker-e2e.sh). Passed with
# --env-file so the repository .env (SMTP, AI provider, profiles...) is never read.
POSTGRES_PASSWORD=e2e_throwaway
SECRET_KEY=e2e_throwaway_secret_key_not_for_real_use_0123456789
SEED_DEMO=true
ALLOWED_ORIGINS=http://host.docker.internal:18930,http://localhost:18930
TURBO_EA_PUBLIC_URL=http://host.docker.internal:18930
MCP_PUBLIC_URL=http://host.docker.internal:18930/mcp
