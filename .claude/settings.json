{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/mark-security-review.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-security-review.sh\"; [ -f \"$f\" ] || exit 0; bash \"$f\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/hook.cjs\" session-start || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "bettercallclaude@synced": false,
    "design@synced": false,
    "legal@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "ponytail@ponytail": true
  },
  "env": {
    "PYTHONUTF8": "1"
  }
}
